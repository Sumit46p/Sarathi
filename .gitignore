# ==============================================================================
# Sarthi - Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 11. Documentation (keep only tracked READMEs)
# ------------------------------------------------------------------------------
*.md
!/README.md
!frontend/README.md
!driver_app/README.md

# ------------------------------------------------------------------------------
# 1. Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg
MANIFEST
*.manifest
*.spec

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
venv/
env/
.venv/
*.venv/
.ENV/
env.bak/
venv.bak/
ENV/

# ------------------------------------------------------------------------------
# 3. Django & Database
# ------------------------------------------------------------------------------
*.sqlite3
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
local_settings.py

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/.env.development
frontend/.env.production
*.pem
*.key
*.crt
*.p12
*.pfx

# ------------------------------------------------------------------------------
# 5. Logs, Caching & Testing
# ------------------------------------------------------------------------------
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml
*,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.tmp
*.temp
*.bak

# ------------------------------------------------------------------------------
# 6. IDEs & Editors
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.iml

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 8. Node.js & React Frontend
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/out/
frontend/build/
frontend/coverage/
*.tsbuildinfo
.eslintcache
.parcel-cache/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
package-lock.json

# Keep frontend's own package-lock.json tracked
!frontend/package-lock.json

