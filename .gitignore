# ==============================================================================
# Sarathi — Mono-Repo .gitignore
# Django backend · React/Vite frontend · Flutter driver app
# ==============================================================================

# ------------------------------------------------------------------------------
# Markdown — keep only the tracked READMEs and AGENTS.MD
# ------------------------------------------------------------------------------
*.md
!README.md
!AGENTS.MD
!frontend/README.md
!driver_app/README.md

# ==============================================================================
# PYTHON / DJANGO (backend)
# ==============================================================================

# Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
*.egg
MANIFEST
*.manifest
*.spec

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Django
*.sqlite3
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
local_settings.py

# Testing & coverage
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml
*,cover
.hypothesis/
.pytest_cache/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
pyrightconfig.json

# ==============================================================================
# NODE.JS / REACT / VITE (frontend)
# ==============================================================================

node_modules/
frontend/node_modules/

# Build output
frontend/dist/
frontend/out/
frontend/build/
frontend/.vite/

# TypeScript
*.tsbuildinfo

# Linting caches
.eslintcache
.parcel-cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/

# Lock files — root level; keep frontend's own
package-lock.json
!frontend/package-lock.json

# ==============================================================================
# FLUTTER / DART (driver_app)
# ==============================================================================

# Dart tooling
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Flutter build artifacts
driver_app/build/
driver_app/.dart_tool/
driver_app/.flutter-plugins
driver_app/.flutter-plugins-dependencies
driver_app/.pub-cache/
driver_app/.pub/
driver_app/.metadata

# Android
driver_app/android/.gradle/
driver_app/android/local.properties
driver_app/android/app/google-services.json
driver_app/android/key.properties
driver_app/android/app/debug/
driver_app/android/app/profile/
driver_app/android/app/release/

# iOS
driver_app/ios/Flutter/Generated.xcconfig
driver_app/ios/Flutter/ephemeral/
driver_app/ios/Flutter/flutter_export_environment.sh
driver_app/ios/Flutter/.last_build_id
driver_app/ios/Runner/GeneratedPluginRegistrant.h
driver_app/ios/Runner/GeneratedPluginRegistrant.m

# Desktop platforms (unused but generated by Flutter)
driver_app/linux/flutter/ephemeral/
driver_app/macos/Flutter/ephemeral/
driver_app/windows/flutter/ephemeral/

# Firebase / Google services
google-services*.json
GoogleService-Info.plist
firebase_options.dart

# Keystores
*.jks
*.keystore

# ==============================================================================
# SECRETS & ENVIRONMENT
# ==============================================================================

.env
.env.*
!.env.example
*.env
*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/.env.development
frontend/.env.production
.env.development

# Certificates & keys
*.pem
*.key
*.crt
*.p12
*.pfx

# ==============================================================================
# DOCKER & INFRASTRUCTURE
# ==============================================================================

# Override files (keep docker-compose.redis.yml tracked)
docker-compose.override.yml
.docker/

# ==============================================================================
# EDITORS & IDEs
# ==============================================================================

.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.iml
.kilo/

# ==============================================================================
# OPERATING SYSTEM ARTIFACTS
# ==============================================================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==============================================================================
# LOGS & TEMP FILES
# ==============================================================================

*.log
logs/
pip-log.txt
pip-delete-this-directory.txt
*.tmp
*.temp
*.bak
.cache/

# ==============================================================================
# LOCAL SCRATCH / ONE-OFF SCRIPTS
# ==============================================================================

cleanup_db.py
recreate_user*.py
test_api.py
test.pdf
test_out.pdf
scratch/